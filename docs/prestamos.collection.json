            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenUser}}"
          }
        ],
        "url": "{{baseUrl}}/api/loans",
        "body": {
          "mode": "raw",
          "raw": "{\"book\": \"{{bookId}}\"}"
        }
      }
    },
