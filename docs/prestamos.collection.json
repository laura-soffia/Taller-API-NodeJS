{
  "openapi": "3.0.3",
  "info": {
    "title": "BiblioTech - Prestamos",
    "version": "1.0.0",
    "description": "Prestamos: R1-R7 + bonus (renovar, multa, top 5)"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/loans": {
      "post": {
        "summary": "Prestar libro (R1,R2,R3,R4)",
        "description": "201 si ok. 409 sin copias / limite 3 / ya lo tienes. 404 libro inexistente. 400 id invalido. 401 sin token.",
        "tags": [
          "Prestamos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "book": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "book": "PEGA_AQUI_EL_ID_DEL_LIBRO"
              }
            }
          }
        }
      },
      "get": {
        "summary": "ADMIN: todos los prestamos (filtro status)",
        "description": "403 si no es ADMIN.",
        "tags": [
          "Prestamos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "RETURNED"
              ]
            },
            "example": "ACTIVE"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          }
        ]
      }
    },
    "/api/loans/me": {
      "get": {
        "summary": "Mis prestamos",
        "description": "Con populate del libro.",
        "tags": [
          "Prestamos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          }
        ]
      }
    },
    "/api/loans/overdue": {
      "get": {
        "summary": "ADMIN: prestamos vencidos",
        "description": "ACTIVE con dueDate vencida.",
        "tags": [
          "Prestamos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          }
        ]
      }
    },
    "/api/loans/top": {
      "get": {
        "summary": "ADMIN bonus: top 5 libros mas prestados",
        "description": "aggregate.",
        "tags": [
          "Prestamos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/loans/{id}/return": {
      "patch": {
        "summary": "Devolver prestamo (R4,R6,R7)",
        "description": "200 ok. 400 ya devuelto. 403 no es dueño ni ADMIN. 404 no existe.",
        "tags": [
          "Prestamos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "PEGA_AQUI_EL_ID_DEL_PRESTAMO"
          }
        ]
      }
    },
    "/api/loans/{id}/renew": {
      "patch": {
        "summary": "Bonus: renovar prestamo (+14 dias, max 1)",
        "description": "400 si ya se renovo o no esta ACTIVE.",
        "tags": [
          "Prestamos"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "PEGA_AQUI_EL_ID_DEL_PRESTAMO"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
